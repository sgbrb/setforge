generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  setlists  Setlist[]
  tracks    Track[]
  folders   Folder[]
  rejectedTracks RejectedTrack[]
  likedSetlists LikedSetlist[]
}

model Folder {
  id            String         @id @default(cuid())
  userId        String
  name          String
  isVirtual     Boolean        @default(false)   // 🆕 pasta virtual
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks        Track[]                              // só físicas
  virtualTracks FolderTrack[]                        // 🆕 só virtuais
  setlists      Setlist[]

  @@index([userId])
}

model FolderTrack {
  id        String   @id @default(cuid())
  folderId  String
  trackId   String
  position  Int
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([folderId, trackId])
  @@index([folderId])
  @@index([trackId])
}

model Track {
  id           String   @id @default(cuid())
  userId       String
  folderId     String?
  title        String
  artist       String   @default("")
  bpm          Int      @default(0)
  key          String   @default("")
  energy       Int      @default(7)
  durationSec  Float    @default(0)
  firstBeatSec Float    @default(0)   // 🆕
  segments     Json?
  fileHash     String?
  rekordboxId  String?  @unique    // 🆕 TrackID do Rekordbox
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderTracks FolderTrack[]    
  
  // 🆕 Adicionado agora para as transições
  transitionsFrom TrackTransition[] @relation("FromTrack")
  transitionsTo   TrackTransition[] @relation("ToTrack")

  @@index([userId])
  @@index([folderId])
}

model Setlist {
  id               String         @id @default(cuid())
  name             String
  eventType        String
  duration         String
  energyCurve      String
  audience         String?
  analysis         String?
  djTip            String?
  peakMoment       String?
  totalDuration    String?
  userId           String
  folderId         String?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder           Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tracks           SetlistTrack[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([folderId])
}

model SetlistTrack {
  id             String  @id @default(cuid())
  position       Int
  trackId        String?  // 🆕 ID original da faixa (upload-xxx)
  title          String
  artist         String
  bpm            Int
  key            String?
  energy         Int
  transitionNote String?
  setlistId      String
  setlist        Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
}

model TrackTransition {
  id          String   @id @default(cuid())
  fromTrackId String
  toTrackId   String
  score       Float    // Nota de 0 a 100 da transição
  mixInSec    Float?   // Onde a música B deve começar (em segundos)
  mixOutSec   Float?   // Onde a música A deve terminar (em segundos)
  
  fromTrack   Track    @relation("FromTrack", fields: [fromTrackId], references: [id], onDelete: Cascade)
  toTrack     Track    @relation("ToTrack", fields: [toTrackId], references: [id], onDelete: Cascade)

  @@unique([fromTrackId, toTrackId])
  @@index([fromTrackId, score])
}
model RejectedTrack {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, trackId])
  @@index([userId])
}
model LikedSetlist {
  id         String   @id @default(cuid())
  userId     String
  setlistId  String
  bpmTarget  Int?
  energyAvg  Float?
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, setlistId])
  @@index([userId])
}