generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  setlists  Setlist[]
  tracks    Track[]
  folders   Folder[]
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    Track[]

  @@index([userId])
}

model Track {
  id           String   @id @default(cuid())
  userId       String
  folderId     String?
  title        String
  artist       String   @default("")
  bpm          Int      @default(0)
  key          String   @default("")
  energy       Int      @default(7)
  durationSec  Float    @default(0)
  segments     Json?
  fileHash     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
}

model Setlist {
  id            String         @id @default(cuid())
  name          String
  eventType     String
  duration      String
  energyCurve   String
  audience      String?
  analysis      String?
  djTip         String?
  peakMoment    String?
  totalDuration String?
  tracks        SetlistTrack[]
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model SetlistTrack {
  id             String  @id @default(cuid())
  position       Int
  title          String
  artist         String
  bpm            Int
  key            String?
  energy         Int
  transitionNote String?
  setlistId      String
  setlist        Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
}